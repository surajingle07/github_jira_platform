# Server & Environment Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Persistence (MongoDB)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# GitHub Integration Configuration
# Personal Access Token (classic with repo & read:org scopes, or fine-grained token)
GITHUB_TOKEN=ghp_your_github_token_here
# Optional default repository scope (owner/repo)
GITHUB_REPOSITORY=surajingle07/github_jira_platform
# Webhook secret for HMAC SHA-256 signature verification (FR-10)
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_key

# Jira Cloud Integration Configuration
# Jira Cloud site base URL (e.g. https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net
# Atlassian account email address
JIRA_EMAIL=your-email@example.com
# Atlassian API token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
